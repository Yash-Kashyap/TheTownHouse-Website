---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  schema?: string;
  grain?: boolean;
}

const {
  title,
  description,
  ogTitle = "The Town House · Nahan",
  ogDescription = "All-day cafe & kitchen near Delhi Gate, Nahan. Open daily 11 am–11 pm.",
  ogImage = "/assets/townhouse-logo-green.png",
  schema,
  grain = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    {schema && <script type="application/ld+json" set:html={schema} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Mukta:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div
      style="font-family:'Mukta',sans-serif;font-size:17px;line-height:1.6;letter-spacing:-0.005em;color:#15291F;background:#F3EEE3;min-height:100vh;position:relative;overflow-x:clip"
    >
      {grain && (
        <div
          aria-hidden="true"
          style="position:fixed;inset:0;pointer-events:none;z-index:60;opacity:0.06;mix-blend-mode:multiply;background-image:url(data:image/svg+xml;utf8,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%27180%27%20height=%27180%27%3E%3Cfilter%20id=%27n%27%3E%3CfeTurbulence%20type=%27fractalNoise%27%20baseFrequency=%270.85%27%20numOctaves=%272%27%20stitchTiles=%27stitch%27/%3E%3CfeColorMatrix%20values=%270%200%200%200%200.3%200%200%200%200%200.25%200%200%200%200%200.2%200%200%200%200.9%200%27/%3E%3C/filter%3E%3Crect%20width=%27100%25%27%20height=%27100%25%27%20filter=%27url(%23n)%27/%3E%3C/svg%3E)"
        />
      )}
      <slot />
    </div>

    <script>
      function setupReveal() {
        const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) return;

        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              const el = e.target as HTMLElement;
              el.style.opacity = '1';
              el.style.translate = '0 0';
              io.unobserve(el);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

        let i = 0;
        document.querySelectorAll('[data-reveal]:not([data-rv])').forEach((elem) => {
          const el = elem as HTMLElement;
          el.setAttribute('data-rv', '1');
          const r = el.getBoundingClientRect();
          if (r.top < window.innerHeight) {
            i++;
          }
          el.style.opacity = '0';
          el.style.translate = '0 24px';
          el.style.transition = (el.style.transition ? el.style.transition + ', ' : '') +
            `opacity .9s cubic-bezier(.16,1,.3,1) ${(i % 6) * 0.08}s, translate .9s cubic-bezier(.16,1,.3,1) ${(i % 6) * 0.08}s`;
          io.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupReveal);
      } else {
        setupReveal();
      }
    </script>
  </body>
</html>

