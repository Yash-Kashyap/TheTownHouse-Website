---
interface Props {
  bilingual?: boolean;
}

const { bilingual = true } = Astro.props;
---

<section aria-labelledby="h-hero" style="padding:clamp(48px,7vw,96px) clamp(16px,4vw,64px) clamp(128px,14vw,176px)">
  <div style="max-width:1360px;margin:0 auto;display:flex;flex-wrap:wrap;gap:clamp(48px,6vw,96px);align-items:center">
    <div data-reveal="" style="flex:5 1 360px;min-width:0">
      <p style="margin:0 0 24px;font-size:12px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#4B5B51">All-day cafe &amp; kitchen · Delhi Gate, Nahan</p>
      <h1 id="h-hero" style="margin:0;font-family:'Young Serif',serif;font-weight:400;font-size:clamp(3rem,6.4vw,6.25rem);line-height:0.98;letter-spacing:-0.03em;text-wrap:balance">The town keeps leaving us notes.</h1>
      {bilingual && <p lang="hi" style="margin:24px 0 0;font-size:22px;font-weight:500;color:#0F3A2B">नाहन की बातें, हमारी दीवार पर।</p>}
      <p style="margin:24px 0 0;max-width:46ch;color:#4B5B51;text-wrap:pretty">Every note on that wall is a real Google review. The actual sticky-note arch is inside, past the sage walls and the black-and-white photos of old Nahan.</p>
      <div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:32px">
        <a href="tel:+919882990174" class="inline-flex items-center min-h-[56px] px-8 rounded-full bg-[#C4441E] hover:bg-[#A93815] text-[#FFF9F2] font-semibold no-underline transition-colors">Call to book a table</a>
        <a href="https://www.google.com/maps/dir/?api=1&destination=The+Town+House+MC+Complex+Delhi+Gate+Nahan" target="_blank" rel="noopener" class="inline-flex items-center min-h-[56px] px-8 rounded-full border-[1.5px] border-[#15291F] hover:bg-[#15291F] hover:text-[#F3EEE3] text-[#15291F] font-semibold no-underline transition-colors">Get directions</a>
      </div>
    </div>
    <div style="flex:7 1 440px;min-width:0">
      <div style="background:#0F3A2B;border-radius:999px 999px 32px 32px;padding:clamp(96px,15vw,176px) clamp(16px,3vw,40px) clamp(24px,3vw,40px);display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,168px),1fr));gap:16px">
        <figure data-reveal="" class="hover:[transform:rotate(0deg)_translateY(-8px)_scale(1.03)]" style="margin:0;background:#F1E3A6;padding:24px 20px;transform:rotate(-3deg);box-shadow:0 18px 24px -16px rgba(0,0,0,0.5);transition:transform .5s cubic-bezier(.16,1,.3,1)">
          <blockquote style="margin:0;font-family:'Young Serif',serif;font-size:17px;line-height:1.35">“The atmosphere is really cozy and welcoming… the staff is super friendly.”</blockquote>
          <figcaption style="margin-top:16px;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#4B4320">Anu S. · ★★★★★</figcaption>
        </figure>
        <a href="https://www.google.com/maps/search/?api=1&query=The+Town+House+Nahan" target="_blank" rel="noopener" data-reveal="" class="hover:[transform:rotate(0deg)_translateY(4px)_scale(1.03)] hover:text-[#15291F]" style="display:block;text-decoration:none;color:#15291F;background:#EFC9C1;padding:24px 20px;transform:rotate(2deg) translateY(16px);box-shadow:0 18px 24px -16px rgba(0,0,0,0.5);transition:transform .5s cubic-bezier(.16,1,.3,1)">
          <span style="display:block;font-family:'Young Serif',serif;font-size:64px;line-height:1;letter-spacing:-0.03em">4.6</span>
          <span style="display:block;margin-top:8px;font-size:15px;line-height:1.4">on Google, from 129 reviews</span>
          <span style="display:block;margin-top:16px;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase">Read them ↗</span>
        </a>
        <figure data-reveal="" class="hover:[transform:rotate(0deg)_translateY(-8px)_scale(1.03)]" style="margin:0;background:#D3E4C6;padding:24px 20px;transform:rotate(-1.5deg);box-shadow:0 18px 24px -16px rgba(0,0,0,0.5);transition:transform .5s cubic-bezier(.16,1,.3,1)">
          <blockquote style="margin:0;font-family:'Young Serif',serif;font-size:17px;line-height:1.35">“Their tikkas are mouthwatering. Veg and Non Veg both are great.”</blockquote>
          <figcaption style="margin-top:16px;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#2E4A26">S. G. · ★★★★★</figcaption>
        </figure>
        <figure data-reveal="" class="hover:[transform:rotate(0deg)_translateY(-8px)_scale(1.03)]" style="margin:0;background:#FBF8F1;padding:24px 20px;transform:rotate(3deg);box-shadow:0 18px 24px -16px rgba(0,0,0,0.5);transition:transform .5s cubic-bezier(.16,1,.3,1)">
          <blockquote style="margin:0;font-family:'Young Serif',serif;font-size:17px;line-height:1.35">“Food ka taste bahut hi delicious tha, har dish fresh aur perfectly prepared thi.”</blockquote>
          <figcaption style="margin-top:16px;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#4B5B51">Aakash G. · ★★★★★</figcaption>
        </figure>
        <figure data-reveal="" class="hover:[transform:rotate(0deg)_translateY(-8px)_scale(1.03)]" style="margin:0;background:#F1E3A6;padding:24px 20px;transform:rotate(-2deg) translateY(8px);box-shadow:0 18px 24px -16px rgba(0,0,0,0.5);transition:transform .5s cubic-bezier(.16,1,.3,1)">
          <blockquote style="margin:0;font-family:'Young Serif',serif;font-size:17px;line-height:1.35">“One of the best places to dine with friends and family in Nahan.”</blockquote>
          <figcaption style="margin-top:16px;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#4B4320">Sidharth C. · ★★★★★</figcaption>
        </figure>
        <figure data-reveal="" class="hover:[transform:rotate(0deg)_translateY(-8px)_scale(1.03)]" style="margin:0;background:#D3E4C6;padding:24px 20px;transform:rotate(1.5deg);box-shadow:0 18px 24px -16px rgba(0,0,0,0.5);transition:transform .5s cubic-bezier(.16,1,.3,1)">
          <blockquote style="margin:0;font-family:'Young Serif',serif;font-size:17px;line-height:1.35">“The calm and peaceful ambiance added a special charm.”</blockquote>
          <figcaption style="margin-top:16px;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#2E4A26">Nishant · ★★★★★</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

