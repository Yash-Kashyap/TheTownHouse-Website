---
interface Props {
  bilingual?: boolean;
}

const { bilingual = true } = Astro.props;
---

<section aria-labelledby="h-room" style="padding:clamp(64px,10vw,128px) clamp(16px,4vw,64px)">
  <div style="max-width:1360px;margin:0 auto;display:flex;flex-wrap:wrap;gap:64px clamp(48px,6vw,96px);align-items:center">
    <div style="flex:7 1 440px;min-width:0;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-auto-rows:clamp(40px,5vw,72px)">
      <img
        data-reveal=""
        src="/assets/photos/bw-frames.png"
        alt="Black-and-white framed photographs of old Nahan on the wall"
        loading="lazy"
        style="grid-column:1 / 8;grid-row:1 / 6;width:100%;height:100%;object-fit:cover;border-radius:4px;display:block;min-width:0"
      />
      <img
        data-reveal=""
        src="/assets/photos/sage-wall.png"
        alt="Sage-green wall with scalloped pendant lamps, bookshelves and bentwood chairs"
        loading="lazy"
        style="grid-column:7 / 13;grid-row:2 / 7;width:100%;height:100%;object-fit:cover;border-radius:4px;display:block;min-width:0;position:relative;z-index:2;border:8px solid #FBF8F1;box-sizing:border-box;box-shadow:0 24px 40px -24px rgba(21,41,31,0.55);transform:rotate(1.5deg)"
      />
      <img
        data-reveal=""
        src="/assets/photos/arch.png"
        alt="The sticky-note wall inside a lit orange arch"
        loading="lazy"
        style="grid-column:2 / 7;grid-row:6 / 10;width:100%;height:100%;object-fit:cover;border-radius:999px 999px 4px 4px;display:block;min-width:0;position:relative;z-index:3;border:8px solid #FBF8F1;box-sizing:border-box;box-shadow:0 24px 40px -24px rgba(21,41,31,0.55);transform:rotate(-2deg)"
      />
      <img
        data-reveal=""
        src="/assets/photos/sage-beams.png"
        alt="Dining room with wooden ceiling beams and French doors"
        loading="lazy"
        style="grid-column:8 / 12;grid-row:7 / 10;width:100%;height:100%;object-fit:cover;border-radius:4px;display:block;min-width:0"
      />
    </div>
    <div data-reveal="" style="flex:5 1 320px;min-width:0">
      <p style="margin:0 0 16px;font-size:12px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#4B5B51">The room</p>
      <h2 id="h-room" style="margin:0;font-family:'Young Serif',serif;font-weight:400;font-size:clamp(2.25rem,4.4vw,4rem);line-height:1.05;letter-spacing:-0.025em;text-wrap:balance">Sit down, then look at the walls.</h2>
      {bilingual && <p lang="hi" style="margin:16px 0 0;font-size:20px;font-weight:500;color:#0F3A2B">दीवारों पर पुराना नाहन।</p>}
      <p style="margin:24px 0 0;max-width:44ch;color:#4B5B51;text-wrap:pretty">Sage plaster, bentwood chairs, lamps shaped like flowers, a shelf of records, and a whole wall of old Nahan in black and white. Find the arch of notes on your way out.</p>
      <ul style="list-style:none;padding:0;margin:32px 0 0;display:flex;flex-wrap:wrap;gap:8px">
        <li style="padding:8px 16px;border-radius:999px;background:#E3E8DA;font-size:15px;font-weight:500">Parking</li>
        <li style="padding:8px 16px;border-radius:999px;background:#E3E8DA;font-size:15px;font-weight:500">Free Wi-Fi</li>
        <li style="padding:8px 16px;border-radius:999px;background:#E3E8DA;font-size:15px;font-weight:500">Air-conditioned</li>
        <li style="padding:8px 16px;border-radius:999px;background:#E3E8DA;font-size:15px;font-weight:500">Kid-friendly</li>
      </ul>
    </div>
  </div>
</section>

