<section aria-labelledby="h-notes" style="padding:0 clamp(16px,4vw,64px) clamp(64px,10vw,128px)">
  <div style="max-width:1360px;margin:0 auto;background:#0F3A2B;border-radius:32px;padding:clamp(48px,7vw,96px) clamp(24px,5vw,72px)">
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:48px">
      <h2 id="h-notes" style="margin:0;font-family:'Young Serif',serif;font-weight:400;font-size:clamp(2.25rem,4.4vw,4rem);line-height:1.05;letter-spacing:-0.025em;color:#F3EEE3;max-width:16ch">Nahan, in its own words.</h2>
      <a href="https://www.google.com/maps/search/?api=1&query=The+Town+House+Nahan" target="_blank" rel="noopener" class="hover:text-[#F1E3A6]" style="color:#F3EEE3;font-weight:600;font-size:15px">4.6 ★ on Google · 129 reviews ↗</a>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,220px),1fr));gap:24px">
      <figure style="margin:0;background:#F1E3A6;padding:24px;transform:rotate(-2deg)">
        <blockquote style="margin:0;font-family:'Young Serif',serif;font-size:18px;line-height:1.35">“The atmosphere is really cozy and welcoming… the staff is super friendly.”</blockquote>
        <figcaption style="margin-top:16px;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#4B4320">Anu S.</figcaption>
      </figure>
      <figure style="margin:0;background:#D3E4C6;padding:24px;transform:rotate(1.5deg)">
        <blockquote style="margin:0;font-family:'Young Serif',serif;font-size:18px;line-height:1.35">“Their tikkas are mouthwatering. Veg and Non Veg both are great.”</blockquote>
        <figcaption style="margin-top:16px;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#2E4A26">S. G.</figcaption>
      </figure>
      <figure style="margin:0;background:#FBF8F1;padding:24px;transform:rotate(-1deg)">
        <blockquote style="margin:0;font-family:'Young Serif',serif;font-size:18px;line-height:1.35">“Food ka taste bahut hi delicious tha, har dish fresh aur perfectly prepared thi.”</blockquote>
        <figcaption style="margin-top:16px;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#4B5B51">Aakash G.</figcaption>
      </figure>
      <figure style="margin:0;background:#EFC9C1;padding:24px;transform:rotate(2deg)">
        <blockquote style="margin:0;font-family:'Young Serif',serif;font-size:18px;line-height:1.35">“Everything from the presentation to the taste was excellent.”</blockquote>
        <figcaption style="margin-top:16px;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#5A2E26">Mohit C.</figcaption>
      </figure>
    </div>
  </div>
</section>

