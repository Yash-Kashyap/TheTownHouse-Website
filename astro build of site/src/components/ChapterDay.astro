---
interface Props {
  bilingual?: boolean;
}

const { bilingual = true } = Astro.props;
---

<section id="day" aria-labelledby="h-day" style="padding:clamp(96px,12vw,160px) clamp(16px,4vw,64px) clamp(64px,10vw,128px)">
  <div style="max-width:1360px;margin:0 auto">
    <div data-reveal="" style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px 64px;margin-bottom:clamp(48px,6vw,80px)">
      <div style="flex:2 1 480px">
        <p style="margin:0 0 16px;font-size:12px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#4B5B51">Twelve hours, five moods</p>
        <h2 id="h-day" style="margin:0;font-family:'Young Serif',serif;font-weight:400;font-size:clamp(2.25rem,4.4vw,4rem);line-height:1.05;letter-spacing:-0.025em;text-wrap:balance">What we’re cooking, hour by hour.</h2>
      </div>
      {bilingual && <p lang="hi" style="margin:0;flex:1 1 240px;font-size:20px;font-weight:500;color:#0F3A2B">दिन भर, घंटे दर घंटे।</p>}
    </div>
    <div style="display:flex;gap:clamp(32px,6vw,96px);align-items:flex-start">
      <aside aria-hidden="true" class="hidden min-[960px]:block" style="flex:0 0 clamp(240px,24vw,340px);position:sticky;top:112px">
        <div data-chapterclock="" style="position:relative;width:100%;aspect-ratio:1;border-radius:50%;background:#0F3A2B;box-shadow:inset 0 0 0 12px #0F3A2B,inset 0 0 0 14px #F3EEE3">
          <div style="position:absolute;left:50%;top:8%;height:42%;transform-origin:50% 100%;transform:translateX(-50%) rotate(0deg);font-family:'Young Serif',serif;color:#F3EEE3;font-size:20px;line-height:1">XII</div>
          <div style="position:absolute;left:50%;top:8%;height:42%;transform-origin:50% 100%;transform:translateX(-50%) rotate(90deg);font-family:'Young Serif',serif;color:#F3EEE3;font-size:20px;line-height:1">III</div>
          <div style="position:absolute;left:50%;top:8%;height:42%;transform-origin:50% 100%;transform:translateX(-50%) rotate(180deg);font-family:'Young Serif',serif;color:#F3EEE3;font-size:20px;line-height:1">VI</div>
          <div style="position:absolute;left:50%;top:8%;height:42%;transform-origin:50% 100%;transform:translateX(-50%) rotate(270deg);font-family:'Young Serif',serif;color:#F3EEE3;font-size:20px;line-height:1">IX</div>
          <div data-hand="h" style="position:absolute;left:50%;bottom:50%;width:3%;height:24%;background:#F3EEE3;border-radius:8px;transform-origin:50% 100%;transform:translateX(-50%) rotate(330deg);transition:transform 1.4s cubic-bezier(.16,1,.3,1)"></div>
          <div data-hand="m" style="position:absolute;left:50%;bottom:50%;width:1.8%;height:36%;background:#F3EEE3;border-radius:8px;transform-origin:50% 100%;transform:translateX(-50%) rotate(3960deg);transition:transform 1.4s cubic-bezier(.16,1,.3,1)"></div>
          <div style="position:absolute;left:50%;top:50%;width:6%;aspect-ratio:1;border-radius:50%;background:#C4441E;transform:translate(-50%,-50%)"></div>
        </div>
        <p data-chaplabel="" style="margin:24px 0 0;text-align:center;font-size:13px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#4B5B51">11:00 · Doors open</p>
      </aside>
      <div style="flex:1 1 auto;min-width:0">

        <article data-hour="11" data-label="Doors open" data-reveal="" style="display:flex;flex-wrap:wrap;gap:32px 48px;padding:48px 0 64px;border-top:1px solid rgba(21,41,31,0.14)">
          <div style="flex:1 1 300px;min-width:0">
            <div style="display:flex;align-items:baseline;gap:16px;flex-wrap:wrap">
              <span style="font-family:'Young Serif',serif;font-size:clamp(4rem,8vw,7.5rem);line-height:0.9;letter-spacing:-0.04em">11:00</span>
              {bilingual && <span lang="hi" style="font-size:15px;font-weight:600;color:#4B5B51">सुबह 11 बजे</span>}
            </div>
            <h3 style="margin:24px 0 8px;font-family:'Young Serif',serif;font-weight:400;font-size:clamp(1.75rem,2.6vw,2.25rem);line-height:1.15">Doors open.</h3>
            <p style="margin:0;max-width:44ch;color:#4B5B51">Start slow: a bowl of soup, a salad, a pita-wich, something hot from the tea and coffee list. The window tables are free this early.</p>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:24px">
              <a href="/menu#soup" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Soup</a>
              <a href="/menu#salads" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Salads</a>
              <a href="/menu#wraps" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Pita-wich &amp; Wraps</a>
              <a href="/menu#tea" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Hot Tea &amp; Coffee</a>
            </div>
          </div>
          <div style="flex:0 1 300px;min-width:240px;position:relative;transform:rotate(2deg)">
            <img src="/assets/photos/window-tables.png" alt="Bentwood chairs and tables by the white French windows" loading="lazy" style="display:block;width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:4px;border:8px solid #FBF8F1;box-sizing:border-box;box-shadow:0 20px 32px -24px rgba(21,41,31,0.6)">
            <span aria-hidden="true" style="position:absolute;top:-12px;left:50%;width:96px;height:24px;background:rgba(241,227,166,0.85);transform:translateX(-50%) rotate(-4deg)"></span>
          </div>
        </article>

        <article data-hour="13" data-label="Lunch" data-reveal="" style="display:flex;flex-wrap:wrap-reverse;gap:32px 48px;padding:48px 0 64px;border-top:1px solid rgba(21,41,31,0.14)">
          <div style="flex:0 1 340px;min-width:240px;position:relative;transform:rotate(-2deg)">
            <img src="/assets/photos/dining-hall.png" alt="The dining hall at lunch, green banquettes and wooden tables" loading="lazy" style="display:block;width:100%;aspect-ratio:5/4;object-fit:cover;border-radius:4px;border:8px solid #FBF8F1;box-sizing:border-box;box-shadow:0 20px 32px -24px rgba(21,41,31,0.6)">
            <span aria-hidden="true" style="position:absolute;top:-12px;left:24px;width:88px;height:24px;background:rgba(239,201,193,0.85);transform:rotate(6deg)"></span>
          </div>
          <div style="flex:1 1 300px;min-width:0">
            <div style="display:flex;align-items:baseline;gap:16px;flex-wrap:wrap">
              <span style="font-family:'Young Serif',serif;font-size:clamp(4rem,8vw,7.5rem);line-height:0.9;letter-spacing:-0.04em">13:00</span>
              {bilingual && <span lang="hi" style="font-size:15px;font-weight:600;color:#4B5B51">दोपहर 1 बजे</span>}
            </div>
            <h3 style="margin:24px 0 8px;font-family:'Young Serif',serif;font-weight:400;font-size:clamp(1.75rem,2.6vw,2.25rem);line-height:1.15">Lunch, the proper kind.</h3>
            <p style="margin:0;max-width:44ch;color:#4B5B51">Twenty-six Indian mains, eleven kinds of bread, biryani and rice, with raita on the side.</p>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:24px">
              <a href="/menu#indian-mains" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Indian Mains</a>
              <a href="/menu#breads" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Indian Breads</a>
              <a href="/menu#biryani" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Biryani &amp; Rice</a>
              <a href="/menu#raita" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Curd &amp; Raita</a>
            </div>
          </div>
        </article>

        <article data-hour="17" data-label="Evening" data-reveal="" style="display:flex;flex-wrap:wrap;gap:32px 48px;padding:48px 0 64px;border-top:1px solid rgba(21,41,31,0.14)">
          <div style="flex:1 1 300px;min-width:0">
            <div style="display:flex;align-items:baseline;gap:16px;flex-wrap:wrap">
              <span style="font-family:'Young Serif',serif;font-size:clamp(4rem,8vw,7.5rem);line-height:0.9;letter-spacing:-0.04em">17:00</span>
              {bilingual && <span lang="hi" style="font-size:15px;font-weight:600;color:#4B5B51">शाम 5 बजे</span>}
            </div>
            <h3 style="margin:24px 0 8px;font-family:'Young Serif',serif;font-weight:400;font-size:clamp(1.75rem,2.6vw,2.25rem);line-height:1.15">After college, after office.</h3>
            <p style="margin:0;max-width:44ch;color:#4B5B51">Momos, fries, a milkshake, and a Baba Ji Ki Booti (watermelon, mint and basil) to share across the table.</p>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:24px">
              <a href="/menu#momo" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Momo</a>
              <a href="/menu#fries" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Fries</a>
              <a href="/menu#shakes" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Milk Shakes</a>
              <a href="/menu#beverages" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Beverages</a>
              <a href="/menu#world-starters" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Starters · World</a>
            </div>
          </div>
          <div style="flex:0 1 300px;min-width:240px;position:relative">
            <img src="/assets/photos/momos.png" alt="Momos in a bamboo steamer with chutney" loading="lazy" style="display:block;width:78%;aspect-ratio:1;object-fit:cover;border-radius:4px;border:8px solid #FBF8F1;box-sizing:border-box;transform:rotate(-3deg);box-shadow:0 20px 32px -24px rgba(21,41,31,0.6)">
            <img src="/assets/photos/mojito.png" alt="A mint mocktail with striped straws" loading="lazy" style="display:block;width:62%;aspect-ratio:3/4;object-fit:cover;margin:-96px 0 0 auto;position:relative;border-radius:4px;border:8px solid #FBF8F1;box-sizing:border-box;transform:rotate(4deg);box-shadow:0 20px 32px -24px rgba(21,41,31,0.6)">
          </div>
        </article>

        <article data-hour="20" data-label="Dinner" data-reveal="" style="display:flex;flex-wrap:wrap-reverse;gap:32px 48px;padding:48px 0 64px;border-top:1px solid rgba(21,41,31,0.14)">
          <div style="flex:0 1 340px;min-width:240px;position:relative;transform:rotate(1.5deg)">
            <img src="/assets/photos/penne.png" alt="Penne in a creamy tomato sauce with garlic bread" loading="lazy" style="display:block;width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:4px;border:8px solid #FBF8F1;box-sizing:border-box;box-shadow:0 20px 32px -24px rgba(21,41,31,0.6)">
            <span aria-hidden="true" style="position:absolute;top:-12px;right:24px;width:96px;height:24px;background:rgba(211,228,198,0.9);transform:rotate(-5deg)"></span>
          </div>
          <div style="flex:1 1 300px;min-width:0">
            <div style="display:flex;align-items:baseline;gap:16px;flex-wrap:wrap">
              <span style="font-family:'Young Serif',serif;font-size:clamp(4rem,8vw,7.5rem);line-height:0.9;letter-spacing:-0.04em">20:00</span>
              {bilingual && <span lang="hi" style="font-size:15px;font-weight:600;color:#4B5B51">रात 8 बजे</span>}
            </div>
            <h3 style="margin:24px 0 8px;font-family:'Young Serif',serif;font-weight:400;font-size:clamp(1.75rem,2.6vw,2.25rem);line-height:1.15">Dinner for the whole family.</h3>
            <p style="margin:0;max-width:44ch;color:#4B5B51">Chicken tikka, bhatti chicken and dahi kebab to start, then a hand-tossed pizza or a pasta for the middle of the table.</p>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:24px">
              <a href="/menu#indian-starters" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Starters · Indian</a>
              <a href="/menu#pizza" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Hand-Tossed Pizza</a>
              <a href="/menu#pasta" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Pasta</a>
              <a href="/menu#oriental" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Oriental Gravy</a>
              <a href="/menu#continental" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Continental Mains</a>
            </div>
          </div>
        </article>

        <article data-hour="22" data-label="Something sweet" data-reveal="" style="display:flex;flex-wrap:wrap;gap:32px 48px;padding:48px 0 0;border-top:1px solid rgba(21,41,31,0.14)">
          <div style="flex:1 1 300px;min-width:0">
            <div style="display:flex;align-items:baseline;gap:16px;flex-wrap:wrap">
              <span style="font-family:'Young Serif',serif;font-size:clamp(4rem,8vw,7.5rem);line-height:0.9;letter-spacing:-0.04em">22:00</span>
              {bilingual && <span lang="hi" style="font-size:15px;font-weight:600;color:#4B5B51">रात 10 बजे</span>}
            </div>
            <h3 style="margin:24px 0 8px;font-family:'Young Serif',serif;font-weight:400;font-size:clamp(1.75rem,2.6vw,2.25rem);line-height:1.15">Something sweet before eleven.</h3>
            <p style="margin:0;max-width:44ch;color:#4B5B51">Six desserts, seven shakes, one last Blue Lagoon. Then the walk back past Delhi Gate.</p>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:24px">
              <a href="/menu#desserts" class="hover:border-[#15291F] hover:text-[#15291F]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(21,41,31,0.2);font-size:15px;font-weight:500;text-decoration:none;color:#15291F">Desserts</a>
              <a href="/menu" class="hover:bg-[#0F3A2B] hover:text-[#F3EEE3]" style="display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;background:#15291F;color:#F3EEE3;font-size:15px;font-weight:500;text-decoration:none">The whole menu →</a>
            </div>
          </div>
          <div style="flex:0 1 300px;min-width:240px;position:relative;transform:rotate(-2deg)">
            <img src="/assets/photos/blue-lagoon.png" alt="A Blue Lagoon mocktail by the palms" loading="lazy" style="display:block;width:100%;aspect-ratio:1;object-fit:cover;border-radius:4px;border:8px solid #FBF8F1;box-sizing:border-box;box-shadow:0 20px 32px -24px rgba(21,41,31,0.6)">
          </div>
        </article>

      </div>
    </div>
  </div>
</section>

